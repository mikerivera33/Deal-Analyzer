# AI Providers — app tries them in order: OpenAI → Anthropic → Gemini
# At least one key (or the built-in Gemini key) is required for document parsing.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Vercel Blob — required in production for job storage
# In local dev the app falls back to the filesystem (/tmp/ljm-jobs/)
BLOB_READ_WRITE_TOKEN=

# Airtable — optional, enables Deal History dashboard at /deals
# Create a Personal Access Token at https://airtable.com/create/tokens
# with scopes: data.records:read, data.records:write
# Base ID is the appXXXXXXXXXX string from your Airtable base URL
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# Set automatically by Vercel in production
# VERCEL=1
